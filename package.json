{
  "name": "terrain-barrier-dashboard",
  "private": true,
  "version": "0.4.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "sync-data": "node scripts/sync_real_data.mjs",
    "build-geometry": "node scripts/build_geometry.mjs",
    "build-viz-config": "node scripts/build_viz_config.mjs",
    "build-paper-results": "node scripts/build_paper_results.mjs",
    "build-kapanewon-bands": "node scripts/build_kapanewon_bands.mjs",
    "build-data": "npm run sync-data && npm run build-geometry && npm run build-viz-config && npm run build-paper-results && npm run build-kapanewon-bands"
  },
  "dependencies": {
    "d3-geo": "^3.1.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "topojson-client": "^3.1.0"
  },
  "devDependencies": {
    "@types/d3-geo": "^3.1.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/topojson-client": "^3.1.5",
    "@types/topojson-specification": "^1.0.5",
    "@vitejs/plugin-react": "^4.3.3",
    "topojson-server": "^3.0.1",
    "topojson-simplify": "^3.0.3",
    "typescript": "^5.6.3",
    "vite": "^5.4.10"
  }
}
